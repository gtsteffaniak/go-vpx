+
+// vp9NonrdPredictLargeModelLumaTo omits the whole-block variance scan when
+// the prepared source block is fully visible: model_rd_for_sb_y_large
+// produces the same whole-block inputs while gathering its 8x8 statistics.
+// The third return value says whether the ordinary variance/SSE are ready.
+// Keep legacy prediction and clamped-source validation for unsupported or
+// clipped blocks; callers also retain the small-model fallback.
+func (e *VP9Encoder) vp9NonrdPredictLargeModelLumaTo(c *vp9NonrdPredBlockCtx,
+	inter *vp9InterEncodeState, miRows, miCols, miRow, miCol int,
+	bsize common.BlockSize, mode common.PredictionMode, refFrame int8,
+	mv vp9dec.MV, filter vp9dec.InterpFilter, dst []byte, dstStride int,
+) (variance, sse uint64, varianceReady, ok bool) {
+	if c != nil && refFrame >= 0 && int(refFrame) < len(c.ref) &&
+		c.ref[refFrame].valid && c.x0 >= 0 && c.y0 >= 0 &&
+		c.x0+c.blockW <= c.srcW && c.y0+c.blockH <= c.srcH {
+		ok = e.vp9NonrdCtxPredictLuma(c, &c.ref[refFrame], mv, filter, dst, dstStride)
+		return 0, 0, false, ok
+	}
+	variance, sse, ok = e.vp9NonrdPredictVarianceSSETo(c, inter, miRows,
+		miCols, miRow, miCol, bsize, mode, refFrame, mv, filter, dst, dstStride)
+	return variance, sse, true, ok
+}
