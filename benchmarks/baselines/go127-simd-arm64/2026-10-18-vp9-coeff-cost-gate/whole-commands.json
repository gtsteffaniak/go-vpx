{
  "order": [
    [
      "baseline",
      "candidate"
    ],
    [
      "candidate",
      "baseline"
    ]
  ],
  "env": {
    "GOMAXPROCS": "1"
  },
  "commands": [
    [
      "BINARY",
      "-codec=vp9",
      "-width=320",
      "-height=180",
      "-frames=120",
      "-bitrate=500",
      "-cpu-used=8",
      "-threads=1",
      "-row-mt=false",
      "-encode-only",
      "-auto-libvpx=false",
      "-format=json"
    ],
    [
      "BINARY",
      "-codec=vp9",
      "-width=1280",
      "-height=720",
      "-frames=60",
      "-bitrate=2500",
      "-cpu-used=8",
      "-threads=1",
      "-row-mt=false",
      "-encode-only",
      "-auto-libvpx=false",
      "-format=json"
    ]
  ]
}
