+
+// Non-RD inter mode selection uses modeled coefficient rates. Avoid building
+// the full coefficient-token table when those entries have no normal consumer.
+// Invalidating the old table also preserves the exact scalar cost fallback if
+// an unusual forced block reaches a coefficient-rate consumer.
+func (e *VP9Encoder) refreshVP9CoeffTokenCostsForFrame(hdr *vp9dec.UncompressedHeader) {
+	if e != nil && hdr != nil && hdr.FrameType == common.InterFrame &&
+		!hdr.IntraOnly && e.sf.UseNonrdPickMode != 0 && e.sf.UseCompoundNonrdPickmode == 0 {
+		e.vp9CoeffTokenCostsValid = false
+		return
+	}
 	e.refreshVP9CoeffTokenCosts()
 }
 
